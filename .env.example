# Runtime AI: Gemini remains the active provider while collecting feedback.
AI_PROVIDER=gemini
# Gemini API key: https://aistudio.google.com/apikey
AI_API_KEY=
# Optional: use flash for higher free-tier throughput.
# AI_MODEL=gemini-2.5-flash

# Optional shared feedback and dataset capture.
# Dataset capture requires both values to be set.
# DATABASE_URL=
# TRAINING_CAPTURE=true
# TRAINING_CAPTURE_TTL_DAYS=90

# Optional admin review queue.
# ADMIN_TOKEN=
# FEEDBACK_REQUIRE_APPROVAL=true
# FEEDBACK_SHARED_ENABLED=true
